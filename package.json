{
    "name": "syside-packages",
    "private": true,
    "publisher": "Sensmetry",
    "author": {
        "name": "Sensmetry",
        "url": "https://sensmetry.com/",
        "email": "opensource@sensmetry.com"
    },
    "version": "0.9.1",
    "repository": {
        "url": "https://github.com/arminzavada/sysml-2ls",
        "type": "git"
    },
    "bugs": {
        "url": "https://github.com/arminzavada/sysml-2ls/issues"
    },
    "type": "module",
    "scripts": {
        "postinstall": "node ./scripts/clone-sysml-release.mjs",
        "clean": "pnpm -r clean && shx rm -rf coverage lib *.tsbuildinfo",
        "typecheck": "pnpm -r typecheck",
        "lint": "eslint packages --max-warnings 0",
        "lint:fix": "pnpm lint --fix",
        "check": "pnpm typecheck && pnpm lint",
        "assemble": "pnpm -r assemble",
        "bundle": "pnpm -r --if-present bundle",
        "build": "pnpm check && pnpm assemble && pnpm bundle",
        "build:watch": "pnpm -r --parallel build:watch",
        "test": "vitest run",
        "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=junit.xml",
        "vscode:package": "pnpm -F syside-languageserver assemble && pnpm -F syside-languageclient assemble && pnpm --dir packages/syside-vscode vscode:package",
        "cli": "pnpm -F syside-languageserver assemble && pnpm -F syside-cli bundle",
        "grammar:watch": "pnpm --dir packages/syside-languageserver grammar:watch",
        "clone-stdlib": "node ./scripts/clone-sysml-release.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "~22.20.5",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/expect": "^5.0.5",
        "commander": "^15.0.0",
        "concurrently": "^10.0.6",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-unused-imports": "^4.4.1",
        "fs-extra": "^11.4.1",
        "globals": "^17.13.0",
        "node-stdlib-browser": "^1.3.1",
        "prettier": "^3.9.10",
        "rollup-plugin-license": "^3.7.1",
        "shx": "^0.4.0",
        "tsx": "^4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}
