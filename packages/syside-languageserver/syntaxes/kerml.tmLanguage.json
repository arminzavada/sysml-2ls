{
  "name": "kerml",
  "scopeName": "source.kerml",
  "fileTypes": [
    ".kerml"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.kerml",
      "match": "\\b(specialization|subclassifier|multiplicity|redefinition|conjugation|differences|interaction|specializes|classifier|conjugates|dependency|disjoining|intersects|references|succession|composite|conjugate|connector|featuring|inverting|metaclass|namespace|nonunique|predicate|protected|redefines|abstract|behavior|datatype|disjoint|featured|function|language|metadata|standard|binding|comment|crosses|default|derived|feature|hastype|implies|inverse|library|ordered|package|portion|private|subsets|subtype|chains|filter|import|istype|locale|member|public|return|struct|subset|typing|unions|about|alias|assoc|class|const|false|first|inout|typed|bool|else|expr|flow|from|meta|null|step|then|true|type|all|and|doc|end|for|inv|new|not|out|rep|var|xor|as|by|if|in|of|or|to)\\b"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.kerml",
          "begin": "//\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.kerml"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.kerml"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.kerml"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.kerml"
        }
      ]
    }
  }
}
