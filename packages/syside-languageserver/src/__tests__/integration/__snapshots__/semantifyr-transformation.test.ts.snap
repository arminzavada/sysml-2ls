            redefine refers from: StateNode = start
            redefine refers to: StateNode = Locked
        }
        contains transition1: Transition subsets transitions {
            redefine refers from: StateNode = Locked
            redefine refers to: StateNode = Checking
            redefine contains acceptAction: AcceptItemAction {
                redefine refers viaPort: Port = accessPort
                redefine refers payload: Item = global_BadgeScanned
            }
            redefine contains action: CompositeAction {
                contains assignment1: AssignmentAction subsets children {
                    redefine refers attribute: Attribute = step
                    redefine contains expression: LiteralIntegerExpression {
                        redefine refers value: int = 1
                    }
                }
            }
        }
        contains transition2: Transition subsets transitions {
            redefine refers from: StateNode = Checking
            redefine refers to: StateNode = Unlocked
            redefine contains acceptAction: AcceptItemAction {
                redefine refers viaPort: Port = accessPort
                redefine refers payload: Item = global_AccessGranted
            }
            redefine contains action: CompositeAction {
                contains assignment1: AssignmentAction subsets children {
                    redefine refers attribute: Attribute = step
                    redefine contains expression: LiteralIntegerExpression {
                        redefine refers value: int = 2
                    }
                }
            }
        }
        contains transition3: Transition subsets transitions {
            redefine refers from: StateNode = Unlocked
            redefine refers to: StateNode = Open
            redefine contains acceptAction: AcceptItemAction {
                redefine refers viaPort: Port = accessPort
                redefine refers payload: Item = global_DoorOpened
