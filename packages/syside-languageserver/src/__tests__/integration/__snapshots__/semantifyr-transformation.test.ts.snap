"package semantifyr::sysml::model

import semantifyr::sysml::expressions
import semantifyr::sysml::attributes
import semantifyr::sysml::states
import semantifyr::sysml::parts
import semantifyr::sysml::ports
import semantifyr::sysml::items
import semantifyr::sysml::actions
import semantifyr::sysml::triggers
import semantifyr::sysml::verification

class VarEventE : Item

global containment global_VarEventE: VarEventE[1]

class VarEventF : Item

global containment global_VarEventF: VarEventF[1]

class VarPortE : NormalPort

class ConjugatedVarPortE : ConjugatedPort

class VarPortF : NormalPort

class ConjugatedVarPortF : ConjugatedPort

class TransitionPriorityTopDownModel : Part {
    contains innerFired: BooleanAttribute subsets attributes {
        redefine contains initialValue: LiteralBooleanExpression {
            redefine refers value: bool = false
        }
    }
    contains outerFired: BooleanAttribute subsets attributes {
        redefine contains initialValue: LiteralBooleanExpression {
            redefine refers value: bool = false
        }
    }
    contains input: VarPortE subsets ports
    contains Behaviour: ExhibitedState redefines exhibitState {
        contains Outer: State subsets states {
            contains Inner: State subsets states
            contains InnerDone: State subsets states
            contains initial1: Transition subsets transitions {
                redefine refers from: StateNode = start
                redefine refers to: StateNode = Inner
            }
            contains transition1: Transition subsets transitions {
                redefine refers from: StateNode = Inner
                redefine refers to: StateNode = InnerDone
                redefine contains acceptAction: AcceptItemAction {
                    redefine refers viaPort: Port = input
                    redefine refers payload: Item = global_VarEventE
                }
                redefine contains action: CompositeAction {
                    contains assignment1: AssignmentAction subsets children {
                        redefine refers attribute: Attribute = innerFired
                        redefine contains expression: LiteralBooleanExpression {
                            redefine refers value: bool = true
                        }
                    }
                }
            }
        }
        contains OuterDone: State subsets states
        contains initial1: Transition subsets transitions {
            redefine refers from: StateNode = start
            redefine refers to: StateNode = Outer
        }
        contains transition1: Transition subsets transitions {
            redefine refers from: StateNode = Outer
            redefine refers to: StateNode = OuterDone
            redefine contains acceptAction: AcceptItemAction {
                redefine refers viaPort: Port = input
                redefine refers payload: Item = global_VarEventE
            }
            redefine contains action: CompositeAction {
                contains assignment1: AssignmentAction subsets children {
                    redefine refers attribute: Attribute = outerFired
                    redefine contains expression: LiteralBooleanExpression {
                        redefine refers value: bool = true
                    }
                }
            }
        }
    }
}

