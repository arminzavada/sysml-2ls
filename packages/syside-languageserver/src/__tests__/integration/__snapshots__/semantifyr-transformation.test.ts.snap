                }
                contains transition1: Transition subsets transitions {
                    redefine refers from: StateNode = Initialize
                    redefine refers to: StateNode = HighwayDriving
                    redefine contains acceptAction: AcceptItemAction {
                        redefine refers viaPort: Port = environment
                        redefine refers payload: Item = global_DetectHighway
                    }
                }
                contains transition2: Transition subsets transitions {
                    redefine refers from: StateNode = Initialize
                    redefine refers to: StateNode = UrbanDriving
                    redefine contains acceptAction: AcceptItemAction {
                        redefine refers viaPort: Port = environment
                        redefine refers payload: Item = global_DetectUrban
                    }
                }
                contains transition3: Transition subsets transitions {
                    redefine refers from: StateNode = HighwayDriving
                    redefine refers to: StateNode = Finish
                    redefine contains acceptAction: AcceptItemAction {
                        redefine refers viaPort: Port = environment
