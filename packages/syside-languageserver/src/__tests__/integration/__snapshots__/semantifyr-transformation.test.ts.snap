                    contains transition1: Transition subsets transitions {
                        redefine refers from: StateNode = EnterHighway
                        redefine refers to: StateNode = Cruise
                        redefine contains acceptAction: AcceptItemAction {
                            redefine refers viaPort: Port = environment
                            redefine refers payload: Item = global_Proceed
                        }
                    }
                    contains transition2: Transition subsets transitions {
                        redefine refers from: StateNode = Cruise
                        redefine refers to: StateNode = LaneChange
                        redefine contains acceptAction: AcceptItemAction {
                            redefine refers viaPort: Port = environment
                            redefine refers payload: Item = global_FrontObstacle
                        }
