    contains Behaviour: ExhibitedState redefines exhibitState {
        contains Waiting: State subsets states
        contains GotE: State subsets states
        contains GotF: State subsets states
        contains initial1: Transition subsets transitions {
            redefine refers from: StateNode = start
            redefine refers to: StateNode = Waiting
        }
        contains transition1: Transition subsets transitions {
            redefine refers from: StateNode = Waiting
            redefine refers to: StateNode = GotE
            redefine contains acceptAction: AcceptItemAction {
                redefine refers viaPort: Port = input
                redefine refers payload: Item = global_EventE
            }
        }
        contains transition2: Transition subsets transitions {
            redefine refers from: StateNode = Waiting
            redefine refers to: StateNode = GotF
            redefine contains acceptAction: AcceptItemAction {
                redefine refers viaPort: Port = input
                redefine refers payload: Item = global_EventF
            }
        }
    }
}

class LastWinsModel : Part {
    contains sender: DoubleSenderModel subsets parts
    contains receiver: SlotReceiverModel subsets parts
    contains flow1: Flow subsets flows {
        redefine refers source: Port = sender.output
        redefine refers target: Port = receiver.input
    }
}

